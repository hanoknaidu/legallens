# Checked in. The default is the real backend, which must be running:
#
#   cd ../backend && uv run uvicorn legal_lens.main:app --reload --port 8000
#
# A real database starts empty, so upload a document before asking anything.
#
# To work without a backend — or to see the demo content, which only the mock layer
# ships — set this to true, here or in `.env.development.local`:
VITE_USE_MOCKS=false
