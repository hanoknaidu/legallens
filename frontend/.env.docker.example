# Runtime configuration for the frontend container. Copy to .env.docker and
# adjust. There are no secrets here and there should never be: this image serves
# a static bundle that the browser downloads in full, so anything baked into it
# is public by construction. Backend credentials belong to the backend.

# Where nginx forwards /api/*. No trailing slash.
#   - backend in the same docker network:  http://backend:8000
#   - backend on the Mac host:             http://host.docker.internal:8000
#   - backend as an AKS service:           http://legallens-backend.default.svc.cluster.local:8000
BACKEND_URL=http://host.docker.internal:8000

# Port nginx listens on inside the container. Must stay above 1024 — nothing in
# this image runs as root.
PORT=8080
