# Copy to .env.docker and fill in the key:  cp .env.docker.example .env.docker
#
# Nothing in this file is baked into the image. It is read by `docker run
# --env-file`, and in AKS its contents split between a ConfigMap (everything
# here) and a Secret (the key below, only).

# ---------------------------------------------------------------------------
# REQUIRED for the default llm_provider=anthropic, and required means required:
# without it the service does not start. AnthropicProvider.__init__ raises, the
# lifespan fails, and uvicorn logs
#
#   RuntimeError: llm_provider='anthropic' needs LEGAL_LENS_ANTHROPIC_API_KEY
#
# The container then stays in `running` while serving nothing — see the note in
# DOCKER.md. `/api/health` reporting `degraded` is the *other* case: a key that
# is present but unusable, which the startup probe catches.
#
# Set LEGAL_LENS_LLM_PROVIDER=echo to run the deterministic stub with no key and
# no vendor call at all.
#
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Only for a key not already scoped to a workspace: such a key authenticates and
# then fails every request with a 400 asking to be told a workspace.
# ANTHROPIC_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Server. WORKERS must stay 1 — see the note in the Dockerfile; a second worker
# fractures the SQLite connection, the rate limiter, /metrics and chat/stop.
PORT=8000
WORKERS=1
GRACEFUL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Authentication. OFF BY DEFAULT, and the frontend has no login page — the app
# opens straight into the chat and no route requires a session. The implementation
# behind this flag is real and tested, but with it on the browser app has no way to
# sign in; that needs a login page restoring first. See docs/auth.md.
# LEGAL_LENS_REQUIRE_AUTH=true

# ---------------------------------------------------------------------------
# Open sign-in, which applies only when REQUIRE_AUTH is on. ON BY DEFAULT: an email with no account signs in and gets one,
# created with the password submitted. Anyone who can reach this service can
# therefore create an account and read and upload documents in their own library.
# For anything beyond a local machine, set this false and create accounts with
# `python -m legal_lens.auth.cli create`. It cannot be used to enter an account
# that already exists, or to revive a disabled one. See docs/auth.md.
# LEGAL_LENS_OPEN_SIGNIN=false

# ---------------------------------------------------------------------------
# Identity (docs/auth.md). The app requires a sign-in; these create the first
# account at startup, and only when the users table is empty — so leaving them set
# cannot reset an existing password on the next restart. A container has no shell to
# run `python -m legal_lens.auth.cli create` in, which is why this exists.
# LEGAL_LENS_BOOTSTRAP_EMAIL=you@firm.com
# LEGAL_LENS_BOOTSTRAP_PASSWORD=            # at least 12 characters

# How long a session survives without use. Slid forward on every authenticated
# request, so it is an idle timeout rather than a hard cap. Default 8h.
# LEGAL_LENS_SESSION_TTL_SECONDS=28800

# `Secure` on the session cookie — HTTPS only. Follows the environment by default
# (on in prod), and the only reason to set it is a prod deployment reached over plain
# HTTP, where a Secure cookie is never sent and sign-in appears to do nothing.
# LEGAL_LENS_SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Service
LEGAL_LENS_ENVIRONMENT=prod
LEGAL_LENS_LOG_LEVEL=INFO

# Where the SQLite database, the uploaded originals and the live Qdrant index
# live. Mount a volume here or every upload dies with the container.
LEGAL_LENS_DATA_DIR=/data

# Browser origins allowed to call the API directly. Irrelevant when the frontend
# container proxies /api, because then the browser is same-origin and no
# preflight happens; needed if anything calls this service cross-origin.
# LEGAL_LENS_CORS_ORIGINS=["https://legallens.example.com"]

# ---------------------------------------------------------------------------
# Provider selection. The defaults need no local model, no vector server and no
# extra beyond the base dependency set.
#
# LEGAL_LENS_LLM_PROVIDER=anthropic     # anthropic | echo | orchestrator
# LEGAL_LENS_EMBEDDING_PROVIDER=hashing # hashing | local | voyage
# LEGAL_LENS_VECTOR_STORE=memory        # memory | qdrant
# LEGAL_LENS_INTENT_ROUTER=regex        # regex | model

# `orchestrator` needs an image built with EXTRAS="orchestrator workflows" and
# downloads ~4.5GB of models on its first question. Point the HuggingFace cache
# at the data volume so that happens once per volume rather than once per pod.
# HF_HOME=/data/hf

# One fewer vendor round-trip at boot. The probe is a one-token request that
# turns a revoked or exhausted key into `degraded` instead of a healthy service
# whose every generation fails; it also adds up to probe_timeout_seconds to
# startup, which matters for a tight AKS startup probe.
# LEGAL_LENS_PROBE_LLM_ON_STARTUP=false

# ---------------------------------------------------------------------------
# OCR for scanned PDFs. Needs an image built with EXTRAS="ocr". Off by default
# on purpose: FR-2 requires a scan to be rejected rather than transcribed.
# LEGAL_LENS_OCR_ENABLED=true
# LEGAL_LENS_OCR_ENGINE=claude          # claude needs no system binary
