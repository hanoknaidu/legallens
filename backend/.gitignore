# Secrets. The `*.example` files are the checked-in templates and must be
# re-admitted by name: `.env.*` above them matches `.env.docker.example` too, so
# without the second negation DOCKER.md's `cp .env.docker.example .env.docker`
# refers to a file that is not in a fresh clone.
.env
.env.*
!.env.example
!.env.docker.example

# Local data: the SQLite database, the object store, the vector index.
var/

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.tsbuildinfo

# macOS Finder metadata, which every directory here accumulates.
.DS_Store

# CI report output: coverage data and the HTML/XML reports the pipeline uploads
# as artifacts. Generated by `pytest --cov --html=...`, never committed.
reports/
.coverage
.coverage.*
coverage.xml
