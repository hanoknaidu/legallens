# Repository-wide ignores. Each component also carries its own .gitignore for
# the things only it produces; this file holds what applies everywhere, plus
# the frontend's build output, which is what got committed before this file
# existed.

# Secrets, in any component. The `*.example` files are the checked-in templates
# and have to be re-admitted by name, because `.env.*` matches them too.
.env
.env.*
!.env.example
!.env.docker.example

# Dependencies: installed from a lockfile, never committed. `frontend/` had
# 11,380 of these in the index before this rule.
node_modules/

# Build output: regenerated by `npm run build`.
dist/
.vite/
*.tsbuildinfo

# Python environments and caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Test and coverage output, including Playwright's.
reports/
test-results/
playwright-report/
.coverage
.coverage.*
coverage.xml

# Local data: the SQLite database, the object store, the vector index.
var/

# macOS Finder metadata, which every directory here accumulates.
.DS_Store
